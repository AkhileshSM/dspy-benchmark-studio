# --- Ollama (required for the Q&A model) ---
# Cloud or self-hosted Ollama endpoint. The /v1/chat/completions path is
# tried first; /api/chat is the automatic fallback.
#
# Inside Docker, use host.docker.internal (with extra_hosts: host-gateway
# already set in compose) so the agent container can reach the host.
# If running outside Docker, use http://localhost:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=

# Available on the local dev Ollama at the time of writing:
#   qwen3.5:4b-mlx           (default, thinking model)
#   nemotron-3-super:cloud
#   kimi-k2.7-code:cloud
#   gemma4:31b-cloud
#   minicpm-3.1:cloud
#   nomic-embed-text:latest
# Pick any one — the dashboard model selector lets you override per run.
OLLAMA_MODEL=qwen3.5:4b-mlx

# --- AgentField ---
# The agent's app.ai() model string. Keep in sync with OLLAMA_MODEL.
AI_MODEL=ollama/qwen3.5:4b-mlx

# --- Optional overrides ---
AGENT_NODE_ID=dspy-benchmark-studio
AGENT_NODE_PORT=8001
AGENTFIELD_HTTP_PORT=8080

# LLM provider: auto | ollama | openai
#   auto   — infer from model prefix, then API keys, else Ollama
#   ollama — native Ollama (/v1/chat/completions, fallback /api/chat)
#   openai — any OpenAI-compatible /v1/chat/completions server
LLM_PROVIDER=auto

# --- Ollama ---
# Inside Docker, use host.docker.internal (extra_hosts: host-gateway is
# already set in compose) so the agent container can reach the host.
# Outside Docker, use http://localhost:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.2

# --- OpenAI-compatible (OpenAI, OpenRouter, Groq, vLLM, LM Studio, …) ---
# Leave OPENAI_BASE_URL empty to use the vendor default (api.openai.com
# for openai/…, openrouter.ai for openrouter/…, etc.).
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=

# --- AgentField ---
# LiteLLM-style model string used as the default when the request omits `model`.
# Keep the prefix in sync with the provider you intend to use:
#   ollama/llama3.2
#   openai/gpt-4o-mini
#   openrouter/google/gemini-2.5-flash
AI_MODEL=ollama/llama3.2

# --- Optional overrides ---
AGENT_NODE_ID=dspy-benchmark-studio
AGENT_NODE_PORT=8001
AGENTFIELD_HTTP_PORT=8080
FRONTEND_PORT=5173
